generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ADVOCATE
  CLERK
}

enum CaseStatus {
  OPEN
  ADJOURNED
  RESERVED
  DISPOSED
  CLOSED
}

enum FollowUpType {
  CALL
  MEETING
  TASK
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
}

enum ReminderChannel {
  EMAIL
  WHATSAPP
}

enum ReminderStatus {
  SENT
  FAILED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role
  active       Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedCases Case[]     @relation("AssignedAdvocate")
  followUps     FollowUp[]
  documents     Document[]
  auditLogs     AuditLog[]
  invoices      Invoice[]
  payments      Payment[]
  reminderLogs  ReminderLog[]
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases Case[]

  @@index([name])
}

model Case {
  id            String     @id @default(cuid())
  caseNumber    String
  title         String
  court         String
  caseType      String
  opposingParty String?
  filingDate    DateTime?
  stage         String?
  /// Agreed professional fee in paise
  agreedFee     Int?
  status        CaseStatus @default(OPEN)
  clientId      String
  advocateId    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  advocate  User?      @relation("AssignedAdvocate", fields: [advocateId], references: [id], onDelete: SetNull)
  hearings  Hearing[]
  followUps FollowUp[]
  documents Document[]
  invoices  Invoice[]

  @@unique([caseNumber, court])
  @@index([advocateId])
  @@index([status])
}

model Hearing {
  id        String    @id @default(cuid())
  caseId    String
  date      DateTime
  purpose   String
  outcome   String?
  nextDate  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([date])
}

model FollowUp {
  id        String       @id @default(cuid())
  caseId    String
  type      FollowUpType
  dueDate   DateTime
  notes     String
  done      Boolean      @default(false)
  ownerId   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  case  Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([dueDate, done])
}

model Document {
  id           String   @id @default(cuid())
  caseId       String
  name         String
  docType      String
  storageKey   String   @unique
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  case       Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
}

/// Uploaded file contents, kept apart from Document so listing documents
/// never loads the bytes. One database backup then covers files too.
model StoredFile {
  key       String   @id
  data      Bytes
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// All money amounts are stored in paise (1 rupee = 100 paise).
model Invoice {
  id          String    @id @default(cuid())
  number      String    @unique
  caseId      String
  issueDate   DateTime
  dueDate     DateTime?
  gstRate     Int
  subtotal    Int
  gstAmount   Int
  total       Int
  notes       String?
  cancelled   Boolean   @default(false)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  case      Case          @relation(fields: [caseId], references: [id], onDelete: Restrict)
  createdBy User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     InvoiceItem[]
  payments  Payment[]

  @@index([issueDate])
}

model InvoiceItem {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  amount      Int
  position    Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id           String      @id @default(cuid())
  invoiceId    String
  date         DateTime
  amount       Int
  mode         PaymentMode
  reference    String?
  recordedById String
  createdAt    DateTime    @default(now())

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User    @relation(fields: [recordedById], references: [id], onDelete: Restrict)
}

/// One row per user, channel and day, so a re-run never sends twice.
model ReminderLog {
  id        String          @id @default(cuid())
  userId    String
  channel   ReminderChannel
  forDate   String
  status    ReminderStatus
  summary   String
  error     String?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, forDate])
  @@index([createdAt])
}
