# PostgreSQL connection string
DATABASE_URL="postgresql://advocate:advocate@localhost:5432/advocate_case_app"
# Long random string used to sign login sessions: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
# First admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe@12345"

# Secret the daily scheduler sends to /api/cron/reminders: openssl rand -hex 32
CRON_SECRET=""

# Reminder email (leave SMTP_HOST empty to turn email off)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Case Follow-up <reminders@example.com>"

# WhatsApp Business Cloud API (leave empty to turn WhatsApp off).
# WHATSAPP_TEMPLATE is an approved template whose body has 3 placeholders:
# {{1}} staff name, {{2}} hearings tomorrow, {{3}} follow-ups due.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE=""
WHATSAPP_TEMPLATE_LANG="en"

# Shown on invoices
FIRM_NAME="Your Law Office"
FIRM_ADDRESS="Address line 1, City, State PIN"
FIRM_GSTIN=""
