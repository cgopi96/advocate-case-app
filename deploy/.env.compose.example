# Copy to /opt/advocate/<env>/.env.compose on the server.
POSTGRES_PASSWORD=change-me-long-random
# App settings file (copy of .env.example with real values, minus DATABASE_URL)
APP_ENV_FILE=/opt/advocate/production/.env.app
# 3000 for production, 3001 for staging (must match the Caddyfile)
APP_PORT=3000
BACKUP_DIR=/opt/advocate/backups/production
BACKUP_KEEP_DAYS=30
